# --- Секреты и параметры деплоя. Всё остальное настраивается в админке (/admin/settings).

# Порт, на котором будет доступен сайт
HTTP_PORT=80

# База данных
POSTGRES_USER=ittrade
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ittrade

# JWT: подпись токенов (openssl rand -hex 48). Если пусто — сгенерируется и сохранится в volume.
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Первый администратор (создаётся только при первом запуске, дальше — в админке)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# true, если сайт открыт по HTTPS (refresh-cookie будет Secure)
COOKIE_SECURE=false

# Лимит размера загружаемого Excel, МБ
MAX_UPLOAD_MB=50
# Количество воркеров API
WEB_CONCURRENCY=2
